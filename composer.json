{
    "name": "yii2-extensions/filepond",
    "type": "yii2-extension",
    "description": "FilePond file upload widget for Yii2 with Cropper.js image editing, previews, validation plugins, and server-side helpers for encoded uploads.",
    "homepage": "https://yii2-framework.github.io/docs/extensions/filepond/",
    "keywords": [
        "cropper",
        "cropperjs",
        "file-upload",
        "filepond",
        "image-crop",
        "image-upload",
        "widget",
        "yii2",
        "yii2-extension"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "docs": "https://yii2-framework.github.io/docs/extensions/filepond/",
        "issues": "https://github.com/yii2-extensions/filepond/issues",
        "source": "https://github.com/yii2-extensions/filepond"
    },
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "ui-awesome/html": "^0.7",
        "ui-awesome/html-helper": "^0.7",
        "yiisoft/yii2": "~2.0.55 || ^22.0@dev"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/coding-standard": "^0.3",
        "php-forge/foxy": "^0.4",
        "php-forge/support": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^13.4",
        "xepozz/internal-mocker": "^1.4",
        "yii2-extensions/phpstan": "^0.6"
    },
    "suggest": {
        "ext-gd": "Required by `ImageCropper` to apply crop rectangles on the server."
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\filepond\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\filepond\\tests\\": "tests"
        }
    },
    "extra": {
        "bootstrap": "yii2\\extensions\\filepond\\Bootstrap",
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "foxy": true,
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-forge/foxy": true,
            "phpstan/extension-installer": true,
            "yiisoft/yii2-composer": true
        },
        "foxy": {
            "manager": "npm"
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check",
        "ecs": "ecs check --fix",
        "ecs-check": "ecs check --ansi",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=-1 vendor/bin/infection"
        ],
        "mutation-static": "@mutation --static-analysis-tool=phpstan",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "static": "phpstan --memory-limit=-1",
        "tests": "phpunit",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "ecs": "Applies coding standard fixes with ECS.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "mutation": "Runs mutation testing with Infection.",
        "mutation-static": "Runs mutation testing with Infection and PHPStan static analysis.",
        "rector": "Applies automated refactoring with Rector.",
        "rector-check": "Previews Rector refactoring without modifying files.",
        "static": "Runs static analysis with PHPStan.",
        "tests": "Runs PHPUnit.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
