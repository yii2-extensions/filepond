{
    "name": "yii2-extensions/filepond",
    "type": "yii2-extension",
    "description": "FilePond file upload widget for Yii2 with Cropper.js image editing, previews, validation plugins, and server-side helpers for encoded uploads.",
    "keywords": [
        "cropper",
        "cropperjs",
        "file-upload",
        "filepond",
        "image-crop",
        "image-upload",
        "widget",
        "yii2",
        "yii2-extension"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Wilmer Arambula",
            "email": "terabytesoftw@gmail.com",
            "homepage": "https://github.com/terabytesoftw",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-fileinfo": "*",
        "ui-awesome/html": "^0.6",
        "ui-awesome/html-helper": "^0.7",
        "yiisoft/yii2": "~2.0.54 || ^22.0@dev"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "maglnet/composer-require-checker": "^4.1",
        "php-forge/coding-standard": "^0.3",
        "php-forge/foxy": "^0.3",
        "php-forge/support": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^12.5",
        "xepozz/internal-mocker": "^1.4",
        "yii2-extensions/phpstan": "^0.5@dev"
    },
    "suggest": {
        "ext-gd": "Required by `ImageCropper` to apply crop rectangles on the server."
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\filepond\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\filepond\\tests\\": "tests"
        }
    },
    "extra": {
        "bootstrap": "yii2\\extensions\\filepond\\Bootstrap",
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "foxy": true
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-forge/foxy": true,
            "phpstan/extension-installer": true,
            "yiisoft/yii2-composer": true
        },
        "foxy": {
            "manager": "npm"
        }
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "mutation": "php -d memory_limit=-1 vendor/bin/infection --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100",
        "mutation-static": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=-1 vendor/bin/infection --threads=4 --ignore-msi-with-no-mutations --min-msi=100 --min-covered-msi=100 --static-analysis-tool=phpstan --static-analysis-tool-options='--memory-limit=-1'"
        ],
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "./vendor/bin/phpunit"
    }
}
